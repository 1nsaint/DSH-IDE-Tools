{
  "name": "dsh-browser",
  "version": "0.7.3",
  "description": "Gated Live browser + Remote Chromium (CDP); Cloudflare fail-fast; DevTools tools for agents; browser_screenshot.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <0.3.0",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "dependencies": {
    "dsh-ide-shared": "file:../dsh-ide-shared"
  }
}
