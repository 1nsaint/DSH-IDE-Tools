{
  "name": "dsh-filelens",
  "version": "1.0.9-local",
  "description": "FileLens — explorer; hero uses title-bar header actions host; host supports file.remove.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Han-Yao94/dsh-filelens.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "file-explorer",
    "filelens"
  ],
  "license": "MIT"
}
