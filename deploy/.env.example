# Copy to .env and edit. Agent IDEs: see AGENTS.md.

# Host docker group id (required for Containers/Database tabs):
#   getent group docker | cut -d: -f3
DOCKER_GID=983

DSH_VERSION=0.1.5-rc.2
DSH_PORT=3080
DSH_HTTPS_PORT=3443

# LAN IP of this host (optional; for --trusted-host)
# DSH_LAN_HOST=192.168.0.50

# Absolute path to the parent folder of compose stacks (Containers tab).
# Example: /home/friend/Containers
CONTAINERS_HOST_ROOT=

# OpenAI-compatible LLM (required for chat). Examples:
#   http://127.0.0.1:11434/v1
#   http://192.168.0.10:8100/v1
#   https://api.openai.com/v1
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# Optional
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
